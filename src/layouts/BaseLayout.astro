---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';

// Global stylesheets, bundled by Astro into a content-hashed /_astro/*.css file
// so CSS changes bust caches. Import order defines the cascade - keep it.
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/sections.css';
import '../styles/responsive.css';

interface Props {
    title: string;
    description: string;
    ogImage?: string;
    ogType?: string;
}

const {
    title,
    description,
    ogImage = '/assets/hero/veilkeeper-key-art-og.jpg',
    ogType = 'website'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index,follow">
    <link rel="canonical" href={canonical}>

    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:site_name" content={SITE.name}>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageUrl}>

    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="alternate" type="application/rss+xml" title="Veilkeeper Development Log" href="/veilkeeper/rss.xml">
    <link rel="preload" href="/assets/fonts/cinzel-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/raleway-latin.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>

<Header />

<main id="top">
    <slot />
</main>

<Footer />
</body>
</html>
