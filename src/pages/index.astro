---
import StudioLayout from '../layouts/StudioLayout.astro';
import { SITE } from '../lib/site';
---
<StudioLayout>
    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <div class="eyebrow">Building worlds worth getting lost in</div>
          <h1 class="visually-hidden">PocketLore Studios</h1>
          <img class="hero-logo" src="/assets/pocketlore-lockup-hero.svg" alt="" width="700" height="658">
          <p class="lead">One deliberate layer at a time.</p>
          <p class="sublead">
            Independent games built around memorable worlds, purposeful systems,
            and experiences worth returning to.
          </p>
        </div>
      </div>
    </section>

    <!-- Games: retain the original project and Veilkeeper anchors. -->
    <section id="games" aria-labelledby="games-heading" class="section">
      <div id="project" class="container">
        <div id="veilkeeper" class="section-heading">
          <h2 id="games-heading" class="section-title">Our Games</h2>
        </div>

        <div class="project-card surface">
          <div class="project-details">
            <div class="project-header">
              <div class="project-icon">
                <img src="/assets/veilkeeper-logo.webp" alt="Veilkeeper logo" width="256" height="256">
              </div>
              <div class="project-identity">
                <h3 class="project-title">Veilkeeper</h3>
                <span class="project-status">Public alpha available</span>
              </div>
            </div>

            <p class="project-hook">Your army shrinks the deeper you push.</p>

            <p class="project-desc">
              Draft your squad, fight on a tactical grid, and decide who stays behind
              to hold each relay. Every step forward comes at a cost.
            </p>
          </div>
          <picture class="project-artwork">
            <source media="(max-width: 640px)" srcset="/assets/hero/veilkeeper-key-art-hero-portrait.webp" width="1100" height="1468">
            <img class="project-art" src="/assets/hero/veilkeeper-key-art-hero.webp" alt="A lone figure faces a glowing rift above a fractured landscape" width="2560" height="1462" loading="lazy">
          </picture>
          <div class="project-actions">
            <div class="game-actions">
              <a class="studio-button" href="/veilkeeper/">Explore Veilkeeper <span aria-hidden="true">→</span></a>
              <a class="studio-button studio-button-secondary" href={SITE.itchUrl} target="_blank" rel="noopener">Play the free alpha <span aria-hidden="true">↗</span></a>
              <a class="studio-button studio-button-secondary" href="/play">Wishlist on Steam <span aria-hidden="true">↗</span></a>
            </div>
            <p class="game-availability">Free alpha · Windows &amp; Linux · In active development</p>
          </div>
        </div>
      </div>
    </section>

    <!-- About the studio -->
    <section id="about" aria-labelledby="about-heading" class="section">
      <div id="founder" class="container">
        <div class="section-heading">
          <h2 id="about-heading" class="section-title">About PocketLore</h2>
        </div>

        <div class="about-card surface">
          <h3 class="studio-intro">Small studio. Ambitious worlds.</h3>
          <p class="studio-philosophy">
            PocketLore Studios is an independent game studio based in New York&rsquo;s
            Hudson Valley. We believe compelling games grow from strong, playable foundations.
          </p>
          <p class="studio-philosophy">
            Each project begins with something playable. We test what works, refine
            what matters, and build outward, one deliberate layer at a time.
          </p>
          <div class="founder-intro">
            <h3>The Founder</h3>
            <p class="founder-bio">
              I&rsquo;m John Serwatka, the founder and solo developer behind PocketLore Studios.
              I handle design, programming, and production, sharing the experiments,
              challenges, and decisions that shape each game along the way.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <section id="newsletter" aria-labelledby="newsletter-heading" class="section">
      <div class="container">
        <div class="section-heading">
          <h2 id="newsletter-heading" class="section-title">Newsletter</h2>
        </div>
        <div class="newsletter-card surface">
          <div class="newsletter-copy">
            <h3>News from the Studio</h3>
            <p>New demos, development milestones, and occasional looks behind the scenes.
              Follow PocketLore&rsquo;s journey as new worlds take shape.</p>
          </div>
          <div class="newsletter-embed">
            <p class="newsletter-fallback">
              <a href="https://pocketlore-studios.kit.com/aeee3e1f00" class="project-link">
                Subscribe to the newsletter <span aria-hidden="true">→</span>
              </a>
            </p>
            <script is:inline async data-uid="aeee3e1f00" src="https://pocketlore-studios.kit.com/aeee3e1f00/index.js"></script>
          </div>
        </div>
      </div>
    </section>

    <!-- Connect -->
    <section id="connect" aria-labelledby="connect-heading" class="section">
      <div class="container">
        <div class="section-heading">
          <h2 id="connect-heading" class="section-title">Connect</h2>
        </div>

        <div class="connect-grid">
          <a href="https://bsky.app/profile/veilkeepergame.bsky.social" target="_blank" rel="noopener" class="connect-link surface">
            <span class="connect-label">Bluesky</span>
            <span class="connect-desc">Dev updates</span>
          </a>
          <a href="https://x.com/Veilkeepergame" target="_blank" rel="noopener" class="connect-link surface">
            <span class="connect-label">X</span>
            <span class="connect-desc">Cross-posts</span>
          </a>
          <a href="https://discord.com/invite/5zu23e46s6" target="_blank" rel="noopener" class="connect-link surface">
            <span class="connect-label">Discord</span>
            <span class="connect-desc">Community</span>
          </a>
        </div>

        <a href="mailto:contact@pocketlorestudios.com" class="email-link surface">
          contact@pocketlorestudios.com
        </a>
      </div>
    </section>

</StudioLayout>
