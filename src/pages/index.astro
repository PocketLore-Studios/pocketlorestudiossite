---
import StudioLayout from '../layouts/StudioLayout.astro';
import { SITE } from '../lib/site';
---
<StudioLayout>
    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <div class="eyebrow">Building worlds worth getting lost in</div>
          <h1 class="visually-hidden">PocketLore Studios</h1>
          <img class="hero-logo" src="/assets/pocketlore-lockup-hero.svg" alt="" width="700" height="658">
          <p class="lead">One deliberate layer at a time.</p>
          <p class="sublead">
            Each system earns the right to exist before the next one is added.
            Play the free alpha of Veilkeeper, our debut tactical RPG.
          </p>
        </div>
      </div>
    </section>

    <!-- Current Project -->
    <section id="project" aria-label="Veilkeeper" class="section">
      <div class="container">
        <div id="veilkeeper" class="section-heading">
          <span class="section-eyebrow">Our debut game</span>
        </div>

        <div class="project-card surface">
          <div class="project-header">
            <div class="project-icon">
              <img src="/assets/veilkeeper-logo.webp" alt="Veilkeeper logo" width="256" height="256">
            </div>
            <div class="project-identity">
              <h2 class="project-title">Veilkeeper</h2>
              <span class="project-status">Public alpha available</span>
            </div>
          </div>

          <p class="project-hook">Your army shrinks the deeper you push.</p>

          <p class="project-desc">
            Draft your squad, fight on a tactical grid, and choose who stays behind
            to hold each relay. Every step forward means leaving someone behind.
          </p>
          <picture>
            <source media="(max-width: 640px)" srcset="/assets/hero/veilkeeper-key-art-hero-portrait.webp" width="1100" height="1468">
            <img class="project-art" src="/assets/hero/veilkeeper-key-art-hero.webp" alt="A lone figure faces a glowing rift above a fractured landscape" width="2560" height="1462" loading="lazy">
          </picture>
          <div class="game-actions">
            <a class="studio-button" href="/veilkeeper/">Explore Veilkeeper <span aria-hidden="true">→</span></a>
            <a class="studio-button studio-button-secondary" href={SITE.itchUrl} target="_blank" rel="noopener">Play the free alpha <span aria-hidden="true">↗</span></a>
            <a class="studio-button studio-button-secondary" href="/play">Wishlist on Steam <span aria-hidden="true">↗</span></a>
          </div>
          <p class="game-availability">Free alpha · Windows &amp; Linux · In active development</p>
        </div>
      </div>
    </section>

    <!-- Founder -->
    <section id="founder" class="section">
      <div class="container">
        <div class="section-heading">
          <span class="section-eyebrow">Founder</span>
        </div>

        <div class="founder-card surface">
          <h3 class="founder-name">John Serwatka</h3>
          <div class="founder-role">Design · Code · Business</div>
          <p class="founder-bio">
            Solo founder building Veilkeeper openly, one system and story at a time.
            Based in New York&rsquo;s Hudson Valley.
          </p>
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <section id="newsletter" class="section">
      <div class="container">
        <div class="section-heading">
          <span class="section-eyebrow">Newsletter</span>
        </div>
        <script is:inline async data-uid="aeee3e1f00" src="https://pocketlore-studios.kit.com/aeee3e1f00/index.js"></script>
        <noscript>
          <a href="https://pocketlore-studios.kit.com/aeee3e1f00" class="email-link surface">
            Subscribe to the newsletter
          </a>
        </noscript>
      </div>
    </section>

    <!-- Connect -->
    <section id="connect" class="section">
      <div class="container">
        <div class="section-heading">
          <span class="section-eyebrow">Connect</span>
        </div>

        <div class="connect-grid">
          <a href="https://bsky.app/profile/veilkeepergame.bsky.social" target="_blank" rel="noopener" class="connect-link surface">
            <span class="connect-label">Bluesky</span>
            <span class="connect-desc">Dev updates</span>
          </a>
          <a href="https://x.com/Veilkeepergame" target="_blank" rel="noopener" class="connect-link surface">
            <span class="connect-label">X</span>
            <span class="connect-desc">Cross-posts</span>
          </a>
          <a href="https://discord.com/invite/5zu23e46s6" target="_blank" rel="noopener" class="connect-link surface">
            <span class="connect-label">Discord</span>
            <span class="connect-desc">Community</span>
          </a>
        </div>

        <a href="mailto:contact@pocketlorestudios.com" class="email-link surface">
          contact@pocketlorestudios.com
        </a>
      </div>
    </section>

</StudioLayout>
