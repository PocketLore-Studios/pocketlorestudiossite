---
import StudioLayout from '../layouts/StudioLayout.astro';
---
<StudioLayout title="Page Not Found · PocketLore Studios" description="The page you are looking for could not be found." canonicalPath="/404.html" noindex>
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <div class="eyebrow">404</div>
          <h1>This Rift Leads Nowhere</h1>
          <p class="lead">The page you're looking for doesn't exist.</p>
          <p class="sublead">
            <a class="project-link" href="/">Return to safety <span class="arrow">→</span></a>
          </p>
        </div>
      </div>
    </section>
</StudioLayout>
