---
// Full-size viewer for devlog post media. Triggers are `a[data-lightbox]` links
// (see DevlogMedia.astro); without JS they navigate to the image or video file
// instead. Triggers marked `data-lightbox-video` open in the <video> element.
---
<dialog class="lightbox" aria-label="Full-size media">
    <button class="lightbox-close" type="button" aria-label="Close full-size view">✕</button>
    <figure class="lightbox-figure">
        <img class="lightbox-image" alt="">
        <video class="lightbox-image lightbox-video" muted loop playsinline controls hidden></video>
        <figcaption class="lightbox-caption"></figcaption>
    </figure>
    <div class="lightbox-nav" hidden>
        <button class="lightbox-prev" type="button" aria-label="Previous image">←</button>
        <button class="lightbox-next" type="button" aria-label="Next image">→</button>
    </div>
</dialog>

<script>
    const dialog = document.querySelector<HTMLDialogElement>('.lightbox');

    if (dialog && typeof dialog.showModal === 'function') {
        const image = dialog.querySelector<HTMLImageElement>('img.lightbox-image')!;
        const video = dialog.querySelector<HTMLVideoElement>('.lightbox-video')!;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const caption = dialog.querySelector('.lightbox-caption')!;
        const closeButton = dialog.querySelector<HTMLButtonElement>('.lightbox-close')!;
        const nav = dialog.querySelector<HTMLElement>('.lightbox-nav')!;
        const prevButton = dialog.querySelector<HTMLButtonElement>('.lightbox-prev')!;
        const nextButton = dialog.querySelector<HTMLButtonElement>('.lightbox-next')!;

        // Images in the Markdown body aren't wrapped at build time - give them the
        // same link semantics as the header image so they're keyboard-reachable.
        document.querySelectorAll<HTMLImageElement>('.devlog-post-content img').forEach(img => {
            if (img.closest('a')) return;
            const link = document.createElement('a');
            link.href = img.src;
            link.className = 'media-link lightbox-link';
            link.setAttribute('data-lightbox', '');
            img.replaceWith(link);
            link.append(img);
        });

        const triggers = [...document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
        let current = -1;

        // Pause only - resetting the source (removeAttribute + load) races the
        // next open's play() and aborts it. A paused video stops buffering.
        const stopVideo = () => video.pause();

        const show = (index: number) => {
            current = (index + triggers.length) % triggers.length;
            const trigger = triggers[current];
            const pageVideo = trigger.querySelector('video');
            const alt = trigger.querySelector('img')?.alt ?? pageVideo?.getAttribute('aria-label') ?? '';
            caption.textContent = alt;

            if (trigger.hasAttribute('data-lightbox-video')) {
                image.hidden = true;
                image.removeAttribute('src');
                video.hidden = false;
                video.poster = pageVideo?.poster ?? '';
                video.setAttribute('aria-label', alt);
                if (video.src !== trigger.href) video.src = trigger.href;
                video.currentTime = 0;
                // Native controls are always there; autoplay only without reduced motion.
                if (!reducedMotion.matches) video.play().catch(() => {});
            } else {
                stopVideo();
                video.hidden = true;
                image.hidden = false;
                image.src = trigger.href;
                image.alt = alt;
            }
        };

        triggers.forEach((trigger, index) => {
            trigger.addEventListener('click', event => {
                event.preventDefault();
                show(index);
                nav.hidden = triggers.length < 2;
                dialog.showModal();
                closeButton.focus();
            });
        });

        // Stop the video on every close path directly rather than only from the
        // 'close' event, so a playing video can never keep running (and
        // downloading) behind a closed dialog.
        const closeDialog = () => {
            stopVideo();
            dialog.close();
        };

        closeButton.addEventListener('click', closeDialog);
        prevButton.addEventListener('click', () => show(current - 1));
        nextButton.addEventListener('click', () => show(current + 1));

        // Clicks on the backdrop are dispatched to the dialog element itself.
        dialog.addEventListener('click', event => {
            if (event.target === dialog) closeDialog();
        });

        // Escape: the native dialog closes itself after this event.
        dialog.addEventListener('cancel', stopVideo);

        dialog.addEventListener('keydown', event => {
            if (triggers.length < 2) return;
            if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
                event.preventDefault();
                show(event.key === 'ArrowLeft' ? current - 1 : current + 1);
            }
        });

        // Native <dialog> handles Escape; return focus to the image that opened it.
        dialog.addEventListener('close', () => {
            // Guarded: the event is queued, so a late one must not pause a video
            // the dialog has since been reopened to play.
            if (!dialog.open) stopVideo();
            triggers[current]?.focus();
        });
    }
</script>
