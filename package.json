{
  "name": "pocketlore-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc -p worker/tsconfig.json",
    "test": "node --test --test-isolation=none worker/*.test.ts",
    "test:site": "node scripts/check-site.mjs",
    "types": "wrangler types",
    "deploy": "wrangler deploy",
    "deploy:veilkeeper-redirects": "wrangler deploy --config wrangler.veilkeeper.jsonc"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.148.0"
  }
}
